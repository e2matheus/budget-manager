{
  "name": "budget-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "concurrently -k -n api,vite -c blue,magenta \"yarn dev:server\" \"yarn dev:client\"",
    "start:dev": "yarn dev",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "yarn build:server && vite build",
    "dev:compiled": "yarn build:server && concurrently -k -n tsc,api,vite -c yellow,blue,magenta \"tsc -p tsconfig.server.json --watch\" \"node --watch dist-server/index.js\" \"vite\"",
    "start": "NODE_ENV=production node dist-server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
